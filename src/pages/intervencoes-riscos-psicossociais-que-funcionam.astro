---
// Página de conteúdo autoral: a leitura da Escutaris sobre a base de intervenções
// de saúde no trabalho do McKinsey Health Institute (jan/2026).
//
// IMPORTANTE — base autoral da página: as descrições e as análises são escritas por nós.
// Do estudo original vêm apenas as notas de impacto e viabilidade, citadas como dado
// com atribuição. Nunca traduzir nem parafrasear de perto o texto do MHI aqui.
import Layout from '../layouts/Layout.astro';

const whatsappUrl =
