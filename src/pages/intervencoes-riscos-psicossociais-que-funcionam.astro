const fonteUrl =
  'https://www.mckinsey.com/mhi/our-insights/from-potential-to-practical-fueling-performance-with-proven-workplace-health-interventions';

const DIM = { F: 'Física', M: 'Mental', S: 'Social' };
const NIVEL = { I: 'Indivíduo', T: 'Trabalho', E: 'Equipe', O: 'Organização' };

// Cinco traços que se repetem nas intervenções melhor avaliadas. Reescritos por nós.
const tracos = [
  'Fortalecem o que já sustenta o trabalho: apoio entre colegas, margem de decisão, capacidade de adaptação e compromisso de quem lidera.',
  'Acontecem dentro do fluxo do trabalho, não em paralelo a ele. Programa que exige parar o dia para participar tem adesão baixa e vida curta.',
  'Têm entrega simples. Quanto menos dependem de especialista escasso, mais longe conseguem chegar.',
  'Mexem em mais de uma dimensão de saúde ao mesmo tempo, e por isso rendem mais do que a soma das partes.',
  'Definem o que vão medir, em saúde e em resultado de negócio, antes de começar.',
];

const sequencia = [
  {
    t: 'Medir primeiro',
    d: 'Sem linha de base, a escolha da intervenção é palpite. E palpite não se sustenta diante de fiscalização.',
  },
  {
    t: 'Casar a intervenção com o fator encontrado',
    d: 'Se o dado mostrou baixo controle sobre o próprio trabalho, a resposta está em redesenho de tarefa e autonomia, não em aplicativo de meditação.',
  },
  {
    t: 'Combinar, em vez de escolher uma só',
    d: 'Medida de comportamento sem suporte estrutural é desfeita pela realidade do dia seguinte.',
  },
  {
    t: 'Pilotar antes de escalar',
    d: 'Com métrica de saúde e de negócio definida desde o começo, não depois que o resultado aparece.',
  },
  {
    t: 'Pactuar',
    d: 'Plano de ação que não foi acordado com quem vai viver com ele não é plano, é documento.',
  },
];

// n  = número exibido no gráfico e âncora do cartão
// imp/via = notas do MHI (dado citado)
// desc/leitura = texto autoral da Escutaris
// lp = lado do rótulo numérico no gráfico ('r' direita, 'l' esquerda)
// dx = deslocamento horizontal em px, só onde duas intervenções têm notas idênticas
const intervencoes = [
  {
    n: 1,
    nome: 'Saúde mental digital com nudges',
    imp: 6.0, via: 5.7, dim: 'M', nivel: 'I', lp: 'r', dx: 0,
    desc: 'Plataforma de apoio psicológico acessada pelo próprio trabalhador, que combina registro de como ele está, conteúdo ajustado ao que relata e lembretes no momento certo.',
    leitura: 'É a nota de impacto mais alta da base, e também uma das mais viáveis, porque não depende de agenda de especialista. Serve bem como camada de acesso ao cuidado. O risco é a empresa usá-la para substituir a correção do que está adoecendo: acesso a cuidado não conserta jornada mal desenhada.',
    estudo: 'https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5550734/',
  },
  {
    n: 2,
    nome: 'Pausas de descanso ativo em grupo',
    imp: 5.7, via: 6.0, dim: 'S', nivel: 'E', lp: 'l', dx: 0,
